---
import Default from "@astrojs/starlight/components/PageTitle.astro"
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
const chinese = Astro.url.pathname.split("/").includes("zh-cn")
const locale = chinese ? "zh-cn" : "en"
const home = Astro.url.pathname.replace(/\/$/, "") === `${base}/${locale}`
const links = chinese ? [
  ["开始使用", "安装、连接模型，完成第一个任务。", "getting-started/"],
  ["熟悉工作区", "管理项目，查看文件与改动。", "desktop/workspace-tools/"],
  ["扩展 Wuu", "用技能、工具和插件补上所需。", "customize/"],
] : [
  ["Get started", "Install Wuu and run your first task.", "getting-started/"],
  ["Your workspace", "Find files, review changes, and run commands.", "desktop/workspace-tools/"],
  ["Extend Wuu", "Add skills, tools, and plugins.", "customize/"],
]
---
<Default />
{home && <nav class="docs-start" aria-label={chinese ? "文档快捷入口" : "Explore the docs"}>
  {links.map(([title, description, path]) => <a href={`${base}/${locale}/${path}`}><strong>{title}<span aria-hidden="true">↗</span></strong><span>{description}</span></a>)}
</nav>}
