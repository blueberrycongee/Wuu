{
  "schemaVersion": 1,
  "id": "todo",
  "name": "TODO",
  "description": "Visible task tracking with an Inspector summary.",
  "icon": "list-todo",
  "version": "0.1.0",
  "author": { "name": "Wuu" },
  "minimumWuuVersion": "0.1.0",
  "runtime": { "protocol": "wuu-plugin-v1", "command": "@wuu-official-helper:todo", "timeout": 15 },
