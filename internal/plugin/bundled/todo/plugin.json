  "contributes": {
    "presenters": [
      { "id": "todo-tool", "target": "conversation.tool-activity", "mode": "replace", "priority": 20, "title": "TODO update" }
    ]
  },
  "interface": { "displayName": "TODO", "shortDescription": "Track a visible task checklist.", "developerName": "Wuu", "category": "Productivity", "capabilities": ["Write"] },
  "officialNativeHelper": { "id": "todo", "environment": "WUU_TODO_PLUGIN_HELPER", "executable": "wuu-todo-plugin" }
}
